// ProofVisor hosted-console data model.
//
// PostgreSQL is the canonical datasource — portable across Neon, Supabase,
// Fly Postgres, Google Cloud SQL, AWS RDS, or a self-hosted docker container.
// The schema uses only standard SQL types (no Postgres-only extensions),
// so `pg_dump` gives you a clean export you can restore anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person with a login. Owns one or more organizations.
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  displayName           String?
  // Short-lived password-reset token (argon2-hashed). Both the token and the
  // "issuedAt" timestamp are cleared on successful use or expiry (24h).
  resetTokenHash        String?
  resetTokenAt          DateTime?
  // Pending email change: the NEW address awaiting verification, plus the
  // argon2-hashed token mailed to it. Cleared on confirm/cancel/overwrite;
  // stale requests expire after 24h (checked at confirm time, same TTL
  // discipline as the reset token above).
  pendingEmail          String?
  pendingEmailTokenHash String?
  pendingEmailAt        DateTime?
  // Set when the account has PROVEN control of `email`: SSO-JIT
  // creation (provider/IdP asserted it), invite acceptance (the token
  // was mailed there), reset-confirm or change-email confirm (links
  // mailed there). Password signup alone does NOT set it — /signup
  // never verifies the mailbox, so OAuth/OIDC login refuses to
  // auto-link into an unverified password account (pre-hijack: an
  // attacker who pre-registers victim@corp.com would otherwise capture
  // the victim's later "Sign in with Google"). Backfilled for accounts
  // predating the column (grandfathered).
  emailVerifiedAt       DateTime?
  // JWT revocation fence — every session whose iat is before this timestamp
  // is rejected in authenticate(). Bumped on logout and password change so
  // a captured cookie stops working immediately even though the JWT itself
  // is still cryptographically valid until its 7-day exp.
  sessionRevokedAt DateTime?
  // SCIM `externalId` the organisation's identity provider assigned to
  // this user when it provisioned them over /scim/v2. Null for users
  // created by signup, invite, OAuth or SAML JIT. Looked up by the
  // `externalId eq "…"` filter IdPs issue before every create.
  scimExternalId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships         Membership[]
  webauthnCredentials WebauthnCredential[]
  scimGroupMembers    ScimGroupMember[]

  @@map("users")
}

// A user's registered WebAuthn credential (passkey / security key / platform
// authenticator). One user can have several (Yubikey + iPhone + laptop, etc)
// which is standard practice — no single point of loss.
//
// The counter is the WebAuthn signCount — increases monotonically on every
// use and lets us detect cloned authenticators. label is the human name
// ("Zach's YubiKey", "iPhone 15 Pro"). transports hints the browser which
// USB/NFC/BLE/internal channels the credential supports so re-auth prompts
// the right UI.
model WebauthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId Bytes     @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String    @default("") // comma-separated: "usb,nfc,internal"
  label        String    @default("Passkey")
  aaguid       String? // Authenticator model attestation UUID
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// Server-side single-use record for WebAuthn ceremony challenges. The
// challenge travels in a client-held (encrypted, signed) cookie, so
// clearing that cookie on completion is client-honored only: a captured
// verify request + cookies replayed within the 5-minute TTL re-minted a
// session per replay (zero-counter authenticators never trip the clone
// CAS). Inserting sha256(challenge) here with the primary key as the
// uniqueness anchor makes consumption atomic — the second use hits
// P2002 and is refused. Rows are garbage-collected opportunistically
// after 2× the challenge TTL.
model WebauthnCeremonyRecord {
  challengeHash String   @id
  usedAt        DateTime @default(now())

  @@index([usedAt])
  @@map("webauthn_ceremony_records")
}

// A tenant boundary — a team/company account. Every deployment, session,
// receipt, and event belongs to exactly one org.
model Org {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Data retention windows (days). Sessions + their events + receipts
  // older than sessionRetentionDays are purged by the retention sweeper.
  // Audit entries have a separate longer window because compliance
  // frameworks (SOC-2, ISO 27001) generally expect 365 days of
  // authoritative access history.
  //
  // 0 = keep forever (no purge). Sensible defaults: 90 days for
  // operational data, 365 for audit.
  sessionRetentionDays Int @default(90)
  auditRetentionDays   Int @default(365)

  // Optional per-org IP allowlist for console + API-key access. Each
  // entry is a CIDR block (v4 or v6). Empty array = allow from
  // anywhere (default). Non-empty = every /api/v1/* request whose
  // remote IP does NOT fall within one of the CIDRs is refused with
  // 403 forbidden_ip. Health / OAuth callbacks are exempt so the
  // config can't lock ops or an IdP redirect out.
  //
  // The self-lockout guard on PATCH refuses to save an allowlist
  // that would exclude the caller's own current IP.
  ipAllowlist String[] @default([])

  // Billing. `plan` decides the entitlements in lib/entitlements.ts;
  // `planStatus` mirrors the Stripe subscription state. The Stripe ids
  // let the webhook handler find the org a Stripe event belongs to
  // without trusting anything in the event body beyond the signature.
  plan                 String    @default("free") // free | team | enterprise
  planStatus           String    @default("active") // active | past_due | canceled | trialing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  planRenewsAt         DateTime?

  // SCIM 2.0 provisioning settings (RFC 7643/7644). The IdP calls
  // /scim/v2 with a bearer token from ScimToken; these fields decide
  // what a provisioned user becomes and what `active: false` does.
  scimEnabled           Boolean @default(false)
  scimDefaultRole       String  @default("member") // member | admin
  scimDeprovisionAction String  @default("deactivate") // deactivate | remove

  members           Membership[]
  scimTokens        ScimToken[]
  scimGroups        ScimGroup[]
  billingEvents     BillingEvent[]
  deployments       Deployment[]
  samlConfigs       SamlConfig[]
  samlReplayRecords SamlReplayRecord[]
  auditEntries      AuditEntry[]
  invites           Invite[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  policies          Policy[]

  @@map("orgs")
}

// Server-side API key for programmatic console access. Wire scripts,
// CI jobs, and dashboards can authenticate as an org (not a user) with
// `Authorization: Bearer pv_srv_<plaintext>`. Only the argon2 hash is
// stored; plaintext is returned once at create time.
//
// A hint (prefix plus first 8 chars (pv_live_XXXXXXXX)) is stored so the UI can show 'pv_srv_a091…'
// without a lookup. lastUsedAt is bumped opportunistically on
// authenticate. createdBy snapshots the operator email so a revoked
// user's audit trail still shows who created what.
model ApiKey {
  id             String    @id @default(cuid())
  orgId          String
  name           String // "CI runner", "Grafana dashboard"
  tokenHash      String
  tokenHint      String // prefix plus first 8 chars (pv_live_XXXXXXXX) for UI display
  createdById    String?
  createdByEmail String?
  role           String    @default("admin") // acts as this role for RBAC
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  // R158 F1: index the API-key auth hot path.
  // session-middleware.ts:40-50 filters by `tokenHint` on every
  // Bearer-authenticated request. Without this index the query
  // seq-scans the whole api_keys table (which grows monotonically
  // via soft-revoke). See migrations/20260828220000_add_api_key_
  // token_hint_index/migration.sql for the full rationale.
  @@index([tokenHint])
  @@map("api_keys")
}

// Compliance-grade audit trail. Every sensitive action writes one row
// here. Members can read their own org's log; owners can filter and
// export. Retention is a business decision (default forever; a cron
// can trim older-than-N rows if the operator wants).
//
// `event` is a machine-readable slug ("deployment.create", "saml.signin",
// "member.role_changed", "session.export"). `actorEmail` is a snapshot
// so the row survives the actor account being deleted — GDPR erasure
// clears the email while preserving the row shape for compliance.
model AuditEntry {
  id         String   @id @default(cuid())
  orgId      String
  event      String
  actorId    String?
  actorEmail String?
  target     String? // Free-form: deployment name, member email, config displayName, …
  note       String?
  metadata   Json? // Structured details: {oldRole, newRole}, {ip, ua}, {samlConfigId}
  ip         String?
  userAgent  String?
  at         DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
  @@map("audit_entries")
}

// Pending team invite. Owner/admin sends one; invitee clicks the link
// in the email, sets a password if new, and lands as a member.
//
// Token is argon2-hashed at rest; only the plaintext is emailed. Every
// invite has a 7-day TTL. Accepted invites keep the row (acceptedAt set)
// so the audit log can show "accepted N days after sent".
model Invite {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  role           String    @default("member") // owner|admin|member
  tokenHash      String
  invitedById    String? // FK-less snapshot — inviter may leave the org
  invitedByEmail String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([expiresAt])
  // R81 F2: `POST /invites/accept` runs a `WHERE email = ?`
  // scan. The composite `@@unique([orgId, email])` cannot serve
  // this (leftmost prefix is `orgId`), so the anonymous accept
  // endpoint used to seq-scan the whole invites table per
  // request. An attacker who mass-invites the same email
  // (self-signup is cheap) can bloat the table to millions of
  // rows and then hammer /invites/accept from any IP to force
  // seq-scan-per-request — I/O amplification. `email` is a
  // low-cardinality index on a table that grows with
  // invite volume; add it explicitly so the anonymous lookup
  // is O(log n) instead of O(n).
  @@index([email])
  @@map("invites")
}

// Enterprise SAML 2.0 SSO configuration. One per IdP: an org can have
// multiple (e.g. Okta prod + Okta staging, or Okta + Auth0 for M&A).
// Every field here is what an IdP admin pastes into their config.
//
// The workflow:
//  1. Owner creates a config, gives its ACS URL + Entity ID + SP cert to
//     the IdP administrator.
//  2. IdP admin configures the app there and pastes the IdP metadata (or
//     ssoUrl + x509Cert) back into our settings page.
//  3. Enable jitEnabled and set allowedDomains so real users land safely.
model SamlConfig {
  id                       String   @id @default(cuid())
  orgId                    String
  displayName              String // "Okta production", "Auth0 corporate", …
  // IdP-side config the admin pastes:
  ssoUrl                   String // Where we redirect the browser to start authn.
  sloUrl                   String? // Optional Single Logout endpoint.
  entityIdIdp              String // IdP entity ID / issuer.
  x509Cert                 String // IdP signing cert (PEM-encoded, may hold multiple certs during rotation)
  wantAssertionsSigned     Boolean  @default(true) // Reject unsigned assertions.
  wantResponseSigned       Boolean  @default(false) // Some IdPs sign response envelope too.
  allowEncryptedAssertions Boolean  @default(true) // Decrypt if IdP encrypted them.
  signatureAlgorithm       String   @default("sha256")
  digestAlgorithm          String   @default("sha256")
  nameIdFormat             String   @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  // JIT provisioning: on first successful SAML sign-in, create the user
  // + membership if the assertion email is on an allowed domain. Without
  // this, only pre-invited members can sign in via SSO.
  jitEnabled               Boolean  @default(true)
  jitDefaultRole           String   @default("member") // "member" | "admin"
  // Comma-separated allowed email domains for JIT. Empty means "all domains
  // this IdP asserts". Recommended to always set (e.g. "acme.com").
  allowedDomains           String   @default("")
  // If both are non-null we sign our AuthnRequests. Ops rotate these by
  // regenerating a new keypair and posting the new cert to the IdP.
  spPrivateKeyPem          String?
  spCertPem                String?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  org           Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authnRequests SamlAuthnRequest[]

  @@unique([orgId, displayName])
  @@index([orgId])
  @@map("saml_configs")
}

// Shared, short-lived SP-initiated SAML ceremony state. A conditional DELETE
// atomically consumes request + browser binding across replicas and restarts.
// Store only the nonce digest, never the browser's plaintext nonce.
model SamlAuthnRequest {
  id               String   @id @db.VarChar(256)
  configId         String
  orgId            String
  requestTimestamp String   @db.VarChar(64)
  nonceHash        String   @db.VarChar(64)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime @db.Timestamptz(3)

  config SamlConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([expiresAt, id])
  @@index([configId])
  @@map("saml_authn_requests")
}

// One row per successfully consumed SAML Response ID. Prevents replay by
// remembering assertion IDs until they naturally expire past
// NotOnOrAfter. Rows are cleaned up by a periodic sweep or opportunistic
// delete-if-expired at read time.
model SamlReplayRecord {
  id           String   @id @default(cuid())
  orgId        String
  assertionId  String // The IdP-issued Response ID (or Assertion ID)
  notOnOrAfter DateTime // When the assertion legitimately expires.
  createdAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, assertionId])
  @@index([notOnOrAfter])
  @@map("saml_replay_records")
}

// User ↔ Org join with a role.
model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("owner") // "owner" | "admin" | "member" (checked in code)
  // SCIM deprovisioning with `deprovisionAction = deactivate` flips this
  // to false instead of deleting the row: the IdP can re-activate the
  // user later and the audit history stays attached. Every session
  // path (cookie middleware, login, switch-org, SAML ACS, SSE stream)
  // refuses an inactive membership.
  active Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

// A `proofvisord` instance registered with the console. The daemon uses
// `ingestToken` to POST events; the org holds `publicKeyHex` so the console
// can verify receipts offline. Provider secrets never enter this database.
model Deployment {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  environment     String    @default("production") // "production" | "staging" | "development"
  // Hex-encoded 32-byte Ed25519 verifying key, published by the daemon at
  // startup. Optional until the daemon first checks in.
  publicKeyHex    String?
  // Daemon build version as self-reported on /ingest/pubkey. Display
  // metadata only — never trust material. Optional until first check-in.
  daemonVersion   String?
  // Hash of the plaintext ingest token (argon2). Plaintext is shown once at
  // creation and never stored.
  ingestTokenHash String
  ingestTokenHint String // prefix plus first 8 chars (pv_live_XXXXXXXX) for UI display
  lastIngestAt    DateTime?
  // True for the "demo-attack" deployment the console's live-mode
  // "Simulate an attack" creates. Its sessions and receipts are staged
  // by the server (signed with the public demo key), labeled as demo
  // everywhere, excluded from policy-enforcement totals, and removed
  // as a unit by DELETE /api/v1/demo.
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org          Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions     Session[]
  policyStatus DeploymentPolicyStatus?

  @@unique([orgId, name])
  @@index([orgId])
  @@map("deployments")
}

// What a daemon last reported about the policy bundle it pulled from
// GET /api/v1/ingest/policies. One row per deployment, upserted by
// POST /api/v1/ingest/policy-status. `etag` is the bundle hash the
// daemon applied; comparing it with the org's current bundle etag tells
// the console whether that daemon is current or stale. `applied` is
// the list of policy ids the daemon enforces; `unsupported` lists the
// ids it could not enforce with a reason (older daemon, unknown kind).
model DeploymentPolicyStatus {
  id            String   @id @default(cuid())
  deploymentId  String   @unique
  etag          String
  appliedAt     DateTime
  daemonVersion String?
  applied       Json
  unsupported   Json
  updatedAt     DateTime @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@map("deployment_policy_status")
}

// One conversation as observed by the checkpoint.
model Session {
  id                     String    @id @default(cuid())
  deploymentId           String
  // Denormalized from Deployment.orgId. Populated on insert/upsert so
  // org-scoped queries (list, count, aggregate) can use a single index
  // instead of joining via deployments. At 1M+ sessions the join +
  // sort was O(N log N); the compound (orgId, openedAt DESC, id DESC)
  // index below turns cursor pagination into O(log N).
  orgId                  String
  externalId             String // the daemon's own session id
  agent                  String // charter.name
  workflow               String    @default("signed") // "signed" | "unsigned"
  status                 String    @default("live") // "live" | "sealed" | "blocked" | "quarantined_crash_evidence"
  policyVersion          Int       @default(1)
  openedAt               DateTime
  closedAt               DateTime?
  // Rollups — the daemon pushes deltas; totals live here.
  promptTokens           Int       @default(0)
  completionTokens       Int       @default(0)
  costUsdMicros          BigInt    @default(0)
  payoutUsdMicros        BigInt    @default(0)
  blockedPayoutUsdMicros BigInt    @default(0)
  toolsAllowed           Int       @default(0)
  toolsBlocked           Int       @default(0)
  stopReasonId           Int?
  stopReason             String?
  // Staged by POST /api/v1/demo/attack (lives under an isDemo
  // deployment). Denormalized so list queries can label demo rows
  // without a join.
  isDemo                 Boolean   @default(false)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  events     Event[]
  receipt    Receipt?

  @@unique([deploymentId, externalId])
  @@index([deploymentId, openedAt])
  // Primary index for org-wide session listing + counters. openedAt +
  // id are both DESC so cursor pagination is a straight index scan.
  @@index([orgId, openedAt, id])
  // Fast filter: "blocked only" across the whole org.
  @@index([orgId, toolsBlocked])
  @@map("sessions")
}

// One journaled event within a session.
model Event {
  id           String   @id @default(cuid())
  sessionId    String
  seq          Int // monotonically increasing per session — dedupe key
  kind         String // "sys" | "user" | "llm" | "tool" | "block" | "guard" | "audit"
  tag          String // short label ("BLOCKED", "TOOL ✓", "LOOP", …)
  body         String // HTML-safe rendered body — sanitized on ingest
  sub          String? // secondary line
  // Name of the policy this event fired under, when the daemon
  // attributes one (block verdicts, allowlist hits). Powers the real
  // per-policy 24h hit/block counters on /api/v1/policies.
  policyName   String?
  occurredAt   DateTime
  journalCount Int      @default(1) // number of journal entries this row represents

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, occurredAt])
  @@index([policyName, occurredAt])
  @@map("events")
}

// The signed receipt itself. `body` is the canonical receipt JSON as posted
// by the daemon; `sigB64` is the Ed25519 signature. Verification is
// performed client-side using `Deployment.publicKeyHex`.
model Receipt {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  receiptId  String   @unique // UUIDv7 from the receipt itself
  body       String // full canonical JSON
  sigB64     String // Ed25519 signature (base64)
  keyIdHint  String // first 8 hex chars of key_id, for display
  eventCount Int
  issuedAt   DateTime
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// Governance policy definitions as authored in the console. These rows
// are the org's declarative source of truth: daemons pull the enabled
// ones as a signed-hash bundle from GET /api/v1/ingest/policies
// (`pvctl console-sync --watch --pull-policies`) and report what they
// applied to POST /api/v1/ingest/policy-status. For the kinds budget,
// allowlist, rate and schema `body` must be the JSON spec the daemon
// enforces (validated in lib/policy-bundle.ts); guardrail and
// transform keep free text and are documentation/attribution only.
// Hit/block counters are NOT stored here — the read endpoint
// aggregates them from ingest events that carry a policyName
// attribution (Event.policyName), scoped through sessions.orgId.
model Policy {
  id          String   @id @default(cuid())
  orgId       String
  name        String // e.g. "procurement.allowed_vendors"
  kind        String   @default("guardrail") // allowlist | guardrail | budget | rate | schema | transform
  scope       String   @default("tool.*") // event scope the policy applies to
  enabled     Boolean  @default(true)
  description String   @default("")
  body        String   @default("") @db.Text // policy source text as authored
  updatedBy   String   @default("") // email of the last editor, for display
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("policies")
}

// An outbound webhook subscription. Operators wire ProofVisor into their
// Slack channel, PagerDuty routing key, Datadog event stream, or their
// own internal notification bus. Each endpoint subscribes to one or more
// event names (policy.block, session.blocked, apikey.created, etc.).
//
// Payloads are signed with HMAC-SHA256 over the raw body using `secret`.
// Consumers verify by computing the same HMAC and constant-time comparing
// with the X-ProofVisor-Signature header. A ts-nonce anti-replay
// mechanism sits on the same headers.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  url       String
  secret    String // random 32-byte hex, shown once on create
  events    String[] // subscribed event names; ["*"] means everything
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId])
  @@map("webhook_endpoints")
}

// One delivery attempt. Kept for observability so operators can debug
// "why didn't Slack get the alert?" from the console UI without
// grepping application logs. Bounded retention TTL is enforced by a
// background sweeper (7 days by default).
model WebhookDelivery {
  id           String    @id @default(cuid())
  endpointId   String
  event        String
  payload      String    @db.Text
  responseCode Int?
  responseBody String?   @db.Text
  attempt      Int       @default(1)
  status       String    @default("pending") // pending | delivered | failed | retrying
  errorMessage String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?
  nextRetryAt  DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// Bearer token an identity provider presents on /scim/v2. Same storage
// discipline as ApiKey: argon2 hash at rest, plaintext shown once,
// `pv_scim_` prefix plus an 8-char hint so the console can label rows.
model ScimToken {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  tokenHash      String
  tokenHint      String // first 8 chars of the random part
  createdById    String?
  createdByEmail String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([tokenHint])
  @@map("scim_tokens")
}

// SCIM Group resource. Groups map to roles: a group whose displayName
// is "owner", "admin" or "member" (case-insensitive) grants that role
// to its members (see routes/scim.ts roleForGroupName). Members of no
// mapped group fall back to the org's scimDefaultRole when they leave
// a mapped group.
model ScimGroup {
  id          String   @id @default(cuid())
  orgId       String
  displayName String
  externalId  String?
  role        String? // owner | admin | member | null (unmapped)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members ScimGroupMember[]

  @@unique([orgId, displayName])
  @@index([orgId])
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("scim_group_members")
}

// One row per Stripe webhook event the API has processed. The primary
// key is Stripe's event id, so a redelivered event hits the unique
// constraint and is acknowledged without being applied twice.
model BillingEvent {
  id          String   @id // Stripe event id (evt_…)
  type        String
  orgId       String?
  processedAt DateTime @default(now())

  org Org? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId, processedAt])
  @@map("billing_events")
}
