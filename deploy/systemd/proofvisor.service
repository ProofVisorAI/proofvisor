# ProofVisor systemd unit.
#
# Install:
#   sudo useradd --system --home /var/lib/proofvisor --shell /usr/sbin/nologin proofvisor
#   sudo mkdir -p /var/lib/proofvisor /etc/proofvisor
#   sudo cp target/release/proofvisord /usr/local/bin/
#   sudo cp target/release/pvctl /usr/local/bin/
#   cd /etc/proofvisor && sudo pvctl init --preset openai --output proofvisor.toml
#   # Round-6: chown BEFORE keygen — `pvctl keygen` hard-links a temp
#   # file in the parent directory, which needs write permission as the
#   # service user; a root-owned 0755 /etc/proofvisor would EACCES.
#   sudo chown -R proofvisor:proofvisor /var/lib/proofvisor /etc/proofvisor
#   # Round-18 F1: generate the receipt trust anchor BEFORE first boot.
#   # `ProtectSystem=strict` below mounts /etc read-only, so the harness
#   # cannot auto-create the seed at startup — that would EROFS.
#   sudo -u proofvisor pvctl keygen --output /etc/proofvisor/signing.seed
#   sudo chmod 400 /etc/proofvisor/signing.seed
#   sudo chown proofvisor:proofvisor /etc/proofvisor/signing.seed
#   # Round-6: the variable name must match the config's
#   # `upstream_api_key_env` — `init --preset openai` writes
#   # `upstream_api_key_env = "OPENAI_API_KEY"`, and the generic
#   # PV_UPSTREAM_API_KEY fallback is only consulted when the config
#   # names NO key source. The prior instruction here caused a
#   # boot loop ("environment variable OPENAI_API_KEY is not set").
#   echo 'OPENAI_API_KEY=sk-...' | sudo tee /etc/proofvisor/secrets.env
#   sudo chmod 600 /etc/proofvisor/secrets.env
#   sudo chown proofvisor:proofvisor /etc/proofvisor/secrets.env
#   sudo cp deploy/systemd/proofvisor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now proofvisor
#
# Check: pvctl health --url http://127.0.0.1:8484/readyz
#   (/readyz probes spool writability — a full disk keeps the plain
#   /health constant green while every request 503s)

[Unit]
Description=ProofVisor LLM proxy with signed receipts
Documentation=https://github.com/ProofVisorAI/proofvisor
After=network-online.target
Wants=network-online.target
# Round-19 F7: bound the restart-loop budget. Without these, a
# misconfigured PV_CONFIG (bad TOML, port bind conflict) causes
# exit-nonzero → RestartSec=2 → retry, forever. That floods
# journald (systemd-journald throttles a unit at ~1000 msg/30s and
# starts DROPPING messages from unrelated services on the same
# host). StartLimitBurst=5 with StartLimitIntervalSec=60s means
# systemd holds the unit in "failed" after 5 crashes in 1 minute,
# preserving journald capacity for whatever comes next.
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
User=proofvisor
Group=proofvisor
WorkingDirectory=/var/lib/proofvisor
Environment=RUST_LOG=info
Environment=PV_CONFIG=/etc/proofvisor/proofvisor.toml
# Round-17 F10: the signing seed IS the receipt trust anchor.
# Historically it lived inside WorkingDirectory=/var/lib/proofvisor,
# which is ReadWritePaths=. Any operator running `sudo cat` /
# rsync backup / debug shell traversed the same tree that held the
# key. Move it to /etc/proofvisor (read-only config tree),
# owned proofvisor:proofvisor, mode 0400. Install docs already
# instruct pre-generating the seed with `pvctl keygen`.
Environment=PV_SIGNING_SEED_FILE=/etc/proofvisor/signing.seed
# API keys live here, mode 0600, never in the unit file:
EnvironmentFile=-/etc/proofvisor/secrets.env
ExecStart=/usr/local/bin/proofvisord
Restart=on-failure
RestartSec=2

# Round-18 F3 (budget corrected this round): give the daemon room
# for its FULL worst-case shutdown. The old comment assumed a 30 s
# HTTP drain, but the drain phase is
# `max(30, max(upstream_read_timeout_s, mcp_request_timeout_s) + 5)`.
# Both network settings default to 60 s when unset; the `pvctl init`
# template leaves them unset, so the real default budget is
# 65 s drain + 30 s worker wait_idle + 30 s finalize_sessions
# + 5 s telemetry flush = 130 s, ABOVE the previous 125 s: a
# `systemctl restart` SIGKILLed the daemon mid-finalize, dropping
# receipts and truncating ATIF trajectories — the exact failure
# the compose (180 s) and k8s (150 s) budgets were raised to avoid.
# Default systemd DefaultTimeoutStopSec is 90 s on stock installs
# and can be as low as 30 s under distro overrides — always set
# this explicitly. 180 s matches the shipped docker-compose budget
# and covers the default config with 50 s slack; operators raising
# upstream_read_timeout_s above ~110 s must raise this too (or set
# shutdown_drain_timeout_s to cap the drain phase).
TimeoutStopSec=180s
# Deliver SIGTERM to the process group so any spawned child (rare
# but possible via wasmtime host functions) gets a chance to run
# its own cleanup before SIGKILL. Same posture as k8s.
KillMode=mixed

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# ReadWritePaths does NOT include /etc/proofvisor on purpose —
# config + signing seed are read-only after install.
ReadWritePaths=/var/lib/proofvisor
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute=false is required because the WASM policy engine
# (crates/pv-sandbox/src/wasm_policy.rs) uses a Cranelift JIT that maps
# executable-writable memory. Do NOT re-enable this without switching to
# an interpreter-only wasmtime build.
MemoryDenyWriteExecute=false
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
